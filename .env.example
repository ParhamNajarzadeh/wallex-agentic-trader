# ==============================================================================
# WALLEX AGENTIC AI TRADING ENGINE (.env.example)
# StarCoach Agentic AI Hackathon — Wallex Challenge (5,000,000 TMN Spot Engine)
# SECURITY NOTICE: NEVER commit real API keys (.env) to Git!
# ==============================================================================

# 1. Execution & Governance Mode
EXECUTION_MODE=SHADOW                      # BACKTEST | SHADOW | LIVE
CHALLENGE_INITIAL_CAPITAL_TMN=5000000      # 5,000,000 Toman official challenge capital
CHALLENGE_DURATION_HOURS=72.0              # 72-hour hackathon window
CHALLENGE_START_ISO=2026-10-22T12:00:00+03:30
AGENT_VIRTUAL_USER=hackathon-wallex-agent
AGENT_KEY_EXPIRES_AT=2026-10-25T12:00:00+03:30

# 2. Wallex Exchange API & MCP Configuration (https://developers.wallex.ir/docs)
WALLEX_BASE_URL=https://api.wallex.ir
WALLEX_WS_URL=wss://api.wallex.ir/ws
WALLEX_API_KEY=your_wallex_challenge_account_api_key_here
WALLEX_MCP_SERVER_URL=http://localhost:8090/mcp
WALLEX_MAKER_FEE=0.0020                    # 0.20% default Maker fee
WALLEX_TAKER_FEE=0.0025                    # 0.25% default Taker fee
MAX_PRICE_DRIFT_PCT=0.40                   # 0.40% Stale Price Refresh threshold

# 3. Financial Foundation Model: Kronos (https://github.com/shiyu-coder/Kronos)
KRONOS_MODEL_ID=NeoQuasar/Kronos-small     # NeoQuasar/Kronos-mini | NeoQuasar/Kronos-small | NeoQuasar/Kronos-base
KRONOS_TOKENIZER_ID=NeoQuasar/Kronos-Tokenizer-base
KRONOS_DEVICE=cpu                          # cpu | cuda:0
KRONOS_PRED_LEN=12                         # 12 future K-lines horizon
KRONOS_SAMPLE_COUNT=5                      # Monte-Carlo / autoregressive trajectory samples
KRONOS_TEMPERATURE=1.0
KRONOS_TOP_P=0.90

# 4. Unified System-1 Decision Engine (/v1/systemone)
# Supported providers: jev | mizan | laya | kev | fallback
SYSTEM1_PROVIDER=jev
METIS_API_KEY=your_metis_typesafe_api_key_here
JEV_METIS_URL=https://api.metisai.ir/api/v1/wrapper/typesafe/v1/systemone
MIZAN_LOCAL_URL=http://localhost:8007/v1/systemone
MIZAN_MODEL_ID=xmanii/Mizan-4B
LAYA_LOCAL_URL=http://localhost:8008/v1/systemone
KEV_LOCAL_URL=http://localhost:8009/v1/systemone

# 5. System-2 Quant Analyst LLM (DeepSeek V4.1 Flash via BoxAPI / OpenAI-Compatible)
LLM_BASE_URL=https://api.metisai.ir/openai/v1
LLM_API_KEY=your_llm_api_key_here
LLM_MODEL_NAME=deepseek-v4.1-flash
MAX_CONTEXT_TOKENS=12000

# 6. Quantitative Risk Gate Parameters (Hard Guardrails)
MAX_SINGLE_ORDER_PCT=0.18                  # Max 18% (900,000 TMN) per order
MIN_CASH_RESERVE_PCT=0.40                  # Min 40% (2,000,000 TMN) Toman cash reserve
STOP_LOSS_MIN_PCT=0.015                    # 1.5% min dynamic stop-loss distance
STOP_LOSS_MAX_PCT=0.020                    # 2.0% max dynamic stop-loss distance
MIN_EXPECTED_NET_RR=2.0                    # Net Risk/Reward >= 2.0 after two-way fees + spread
MAX_DAILY_DRAWDOWN_PCT=0.030               # 3.0% daily drawdown circuit breaker
END_OF_CYCLE_LIQUIDATION_HOURS=4.0         # Mandatory 100% Toman settlement in final 4 hours

# 7. Observability (Langfuse)
LANGFUSE_PUBLIC_KEY=pk-lf-placeholder
LANGFUSE_SECRET_KEY=sk-lf-placeholder
LANGFUSE_HOST=https://cloud.langfuse.com
